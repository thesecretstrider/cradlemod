{
	"schemaVersion": 1,
	"id": "cradlemod",
	"version": "${version}",
	"name": "Cradle Mod",
	"description": "A Cradle-inspired RPG progression mod. Choose a Path, cycle Madra, and advance through stages of power.",
	"authors": [
		"Aaron Lack"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/cradlemod/icon.png",
